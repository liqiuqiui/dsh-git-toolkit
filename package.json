{
  "name": "dsh-git-toolkit",
  "version": "0.1.0",
  "description": "DeepSeek Harness Web UI 的 Git 分支工具：新建会话时选择要使用的分支，并在已开始的对话中显示当前分支。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/index.js.map",
    "lib/shared.js",
    "lib/shared.d.ts",
    "lib/shared.js.map",
    "lib/host-api.js",
    "lib/host-api.d.ts",
    "lib/host-api.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "src",
    "tsconfig.json",
    "tsconfig.build.json",
    "tsdown.config.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "git",
    "branch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqiuqiui/dsh-git-toolkit.git"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm run clean && pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "tsdown",
    "watch:client": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test",
    "prepack": "npm run clean && npm run build:host && npm run build:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2"
  }
}
