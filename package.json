{
  "name": "dsh-toolkit",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的小功能工具包：每个功能互相独立，可在插件详情页单独开关。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "tsconfig.json",
    "tsconfig.build.json",
    "tsdown.config.ts",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "toolkit",
    "git",
    "branch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqiuqiui/dsh-toolkit.git"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm run clean && pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "tsdown",
    "watch:client": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test",
    "prepack": "npm run clean && npm run build:host && npm run build:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
